// ── Section 8: Cholesky decomposition (symmetric positive-definite) ───────────

// Cholesky factorisation: A = L Lᵀ for symmetric positive-definite A.
// Returns lower-triangular L (n×n flat). Returns zero matrix if A is not SPD
// (detected when a diagonal entry of L would be sqrt of a non-positive number).
// WCET = n³/3 × 16 cycles.
// STUB — full implementation in v0.1.0.
fn cholesky_factor(A: ref Vec<f64>, n: i64) -> Vec<f64> {
    // TODO: Cholesky-Banachiewicz algorithm
    return mat_zeros(n, n);
}

// Solve Ax=b given Cholesky factor L (A=LLᵀ).
// Forward substitution Ly=b, back substitution Lᵀx=y.
// WCET = n² × 10 cycles.
// STUB — full implementation in v0.1.0.
fn cholesky_solve(L: ref Vec<f64>, b: ref Vec<f64>, n: i64) -> Vec<f64> {
